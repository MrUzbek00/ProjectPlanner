{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/project-planning-workflow/integration/1.0/handoff-manifest.schema.json",
  "title": "Handoff manifest",
  "description": "machine-handoff/handoff-manifest.json: the single entry point a downstream engineering system reads first. ProjectPlanner writes it; SoftwareFactory verifies it before processing any task. schema_version is the integration contract version, not the planner file-format version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_version",
    "planner_schema_version",
    "producer",
    "project_id",
    "project_name",
    "specification_version",
    "handoff_status",
    "generated_at",
    "content_fingerprint",
    "task_content_hash",
    "summary",
    "ready_tasks",
    "tasks",
    "files",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "description": "Integration contract version. A consumer rejects a version it does not declare as supported.",
      "const": "1.0"
    },
    "handoff_version": {
      "description": "Label of this emission: the major number follows the specification version, the minor number increases each time the handoff content changes. Informational; content_fingerprint is the identity.",
      "$ref": "#/$defs/version"
    },
    "planner_schema_version": {
      "description": "Version of the planner's own file formats (schemas/common.schema.json). The fields a consumer relies on are fixed by this contract's reference schemas, not by this number.",
      "$ref": "#/$defs/version"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "generator", "generator_version"],
      "properties": {
        "system": { "const": "ProjectPlanner" },
        "generator": { "type": "string", "minLength": 1 },
        "generator_version": { "type": "string", "minLength": 1 }
      }
    },
    "project_id": { "$ref": "#/$defs/projectId" },
    "project_name": { "type": "string" },
    "specification_version": { "type": ["string", "null"] },
    "handoff_status": {
      "description": "READY_FOR_HANDOFF only when the handoff validated without errors, the specification is approved and independently reviewed, at least one task is READY and every validation flag is true.",
      "enum": ["READY_FOR_HANDOFF", "NOT_READY", "INVALID"]
    },
    "generated_at": { "$ref": "#/$defs/dateTime" },
    "content_fingerprint": {
      "description": "sha256 over every listed file except the manifest, with project.json's generated_at removed. Unchanged planning content gives an unchanged fingerprint.",
      "$ref": "#/$defs/contentHash"
    },
    "task_content_hash": {
      "description": "How each task's content_hash is computed, so a consumer knows what a change in it means.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "basis", "covers", "excludes"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "basis": { "const": "task-intent/1" },
        "covers": { "$ref": "#/$defs/stringList" },
        "excludes": { "$ref": "#/$defs/stringList" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "tasks_total",
        "tasks_ready",
        "tasks_blocked",
        "tasks_needs_review",
        "tasks_needs_discovery",
        "tasks_draft",
        "tasks_cancelled"
      ],
      "properties": {
        "requirements": { "$ref": "#/$defs/count" },
        "tasks_total": { "$ref": "#/$defs/count" },
        "tasks_ready": { "$ref": "#/$defs/count" },
        "tasks_blocked": { "$ref": "#/$defs/count" },
        "tasks_needs_review": { "$ref": "#/$defs/count" },
        "tasks_needs_discovery": { "$ref": "#/$defs/count" },
        "tasks_draft": { "$ref": "#/$defs/count" },
        "tasks_cancelled": { "$ref": "#/$defs/count" }
      }
    },
    "ready_tasks": {
      "description": "Every READY task, in the planner's dependency order. Only these may be ingested.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/taskId" }
    },
    "tasks": {
      "description": "Every task in the handoff with the identity a consumer compares to detect planning changes.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "status", "content_hash", "file"],
        "properties": {
          "id": { "$ref": "#/$defs/taskId" },
          "revision": { "type": "integer", "minimum": 1 },
          "status": { "$ref": "#/$defs/plannerTaskStatus" },
          "content_hash": { "$ref": "#/$defs/contentHash" },
          "file": { "type": "string", "pattern": "^tasks/TASK-[0-9]{3,}(?:-S[0-9]{2,})?\\.json$" }
        }
      }
    },
    "files": {
      "description": "Every file of the handoff except the manifest and validation-report.json, with the sha256 of its LF-normalised bytes.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:[a-z-]+\\.json|tasks/TASK-[0-9]{3,}(?:-S[0-9]{2,})?\\.json)$" },
          "role": {
            "enum": [
              "project",
              "requirements",
              "architecture",
              "decisions",
              "domain",
              "backlog",
              "tests",
              "traceability",
              "changes",
              "specification_review",
              "backlog_readiness",
              "task"
            ]
          },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "validation": {
      "description": "Deterministic validation results. A true flag means no error of that kind was found; a consumer rejects the handoff when any flag is false.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid",
        "traceability_valid",
        "architecture_valid",
        "dependency_graph_valid",
        "specification_review_passed",
        "backlog_readiness_valid"
      ],
      "properties": {
        "schema_valid": { "type": "boolean" },
        "traceability_valid": { "type": "boolean" },
        "architecture_valid": { "type": "boolean" },
        "dependency_graph_valid": { "type": "boolean" },
        "specification_review_passed": { "type": "boolean" },
        "backlog_readiness_valid": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "count": { "type": "integer", "minimum": 0 },
    "projectId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*$" },
    "taskId": { "type": "string", "pattern": "^TASK-[0-9]{3,}(?:-S[0-9]{2,})?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "plannerTaskStatus": { "enum": ["DRAFT", "NEEDS_DISCOVERY", "NEEDS_REVIEW", "BLOCKED", "READY", "CANCELLED"] },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
