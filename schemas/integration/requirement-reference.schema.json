{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/project-planning-workflow/integration/1.0/requirement-reference.schema.json",
  "title": "Requirement reference (consumer view)",
  "description": "One entry of machine-handoff/requirements.json `requirements`, as a downstream engineering system reads it when a task names the requirement. The planner's full shape is fixed by schemas/requirement.schema.json; other fields are tolerated.",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "status",
    "scope",
    "priority",
    "acceptance_criteria",
    "architecture_decisions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(?:GOAL-[0-9]{3,}|BR-[0-9]{3,}|RULE-[0-9]{3,}|FR-(?:[A-Z][A-Z0-9]{1,11}-)?[0-9]{3,}|NFR-[0-9]{3,}|DR-[0-9]{3,}|IR-[0-9]{3,}|SR-[0-9]{3,}|UXR-[0-9]{3,}|TR-[0-9]{3,})$"
    },
    "type": {
      "enum": [
        "business_goal",
        "business",
        "business_rule",
        "functional",
        "non_functional",
        "data",
        "integration",
        "security",
        "ux",
        "technical"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "description": "Only an approved requirement may be implemented.",
      "enum": ["draft", "confirmed", "approved", "superseded", "rejected"]
    },
    "scope": {
      "description": "Only an in_scope requirement may be implemented. null means not yet classified.",
      "enum": ["in_scope", "out_of_scope", "future", "pending_decision", null]
    },
    "priority": { "type": "string" },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{3,}$" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
