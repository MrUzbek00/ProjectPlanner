{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/project-planning-workflow/schemas/1.5/specification-review.schema.json",
  "title": "Independent specification review (specification-review.json)",
  "description": "The independent specification review, computed from reviews/specification-review.md and its frozen cycles in reviews/history/. The review is performed by a SPECIFICATION REVIEWER who is not the specification's author; findings are REVIEW-### records that are resolved by the author and verified in a later cycle, never silently fixed. overall_result is recomputed by tools/validate_handoff.py from the findings: an unresolved CRITICAL or MAJOR finding, or any issue in the review record, is FAIL.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "review_version", "review_cycle", "review_date", "reviewer",
    "specification_author", "overall_result", "summary", "cycles", "findings", "issues", "source_path"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "review_version": {
      "description": "The specification version this review covers. It must equal project.json version for the review to support readiness.",
      "type": ["string", "null"]
    },
    "review_cycle": {
      "description": "The current review cycle, from 1. 0 when no review exists.",
      "type": "integer",
      "minimum": 0
    },
    "review_date": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/isoDate" }] },
    "reviewer": { "type": ["string", "null"] },
    "specification_author": { "type": ["string", "null"] },
    "overall_result": { "$ref": "common.schema.json#/$defs/reviewResult" },
    "summary": {
      "description": "Counts over all findings. critical, major, minor and observation count unresolved findings (OPEN, ACKNOWLEDGED, IN_RESOLUTION, or a CRITICAL finding recorded as ACCEPTED_RISK); open is their sum.",
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "major", "minor", "observation", "open", "accepted_risk", "resolved", "rejected", "total", "resolved_since_previous"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "observation": { "type": "integer", "minimum": 0 },
        "open": { "type": "integer", "minimum": 0 },
        "accepted_risk": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "resolved_since_previous": { "type": "integer", "minimum": 0 }
      }
    },
    "cycles": {
      "description": "Every review cycle in order: the closed cycles from the history (each frozen in its snapshot) and the current one. Counts are the unresolved findings at the close of the cycle; finding_count is their sum.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_cycle", "review_date", "review_version", "overall_result", "finding_count", "critical_count",
          "major_count", "minor_count", "observation_count", "accepted_risk_count", "resolved_since_previous", "snapshot"
        ],
        "properties": {
          "review_cycle": { "type": "integer", "minimum": 1 },
          "review_date": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/isoDate" }] },
          "review_version": { "type": ["string", "null"] },
          "overall_result": { "$ref": "common.schema.json#/$defs/reviewResult" },
          "finding_count": { "type": "integer", "minimum": 0 },
          "critical_count": { "type": "integer", "minimum": 0 },
          "major_count": { "type": "integer", "minimum": 0 },
          "minor_count": { "type": "integer", "minimum": 0 },
          "observation_count": { "type": "integer", "minimum": 0 },
          "accepted_risk_count": { "type": "integer", "minimum": 0 },
          "resolved_since_previous": { "type": "integer", "minimum": 0 },
          "snapshot": {
            "description": "Frozen copy of the closed cycle, relative to the project folder; null for the current cycle.",
            "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/sourcePath" }]
          }
        }
      }
    },
    "findings": {
      "description": "Every finding ever raised, in ID order. Findings are never deleted; they are closed with a status.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "issues": {
      "description": "Defects in the review record itself, found by the tools (for example a reviewer who is also the author, a stated result the findings do not support, a missing snapshot). Any issue makes overall_result FAIL.",
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "source_path": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/sourcePath" }] }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "severity", "category", "status", "raised_in_cycle", "closed_in_cycle", "affected_artifacts",
        "return_to_stage", "evidence", "conflict", "why_it_matters", "required_action", "resolution", "source_path"
      ],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/reviewFindingId" },
        "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "severity": {
          "description": "CRITICAL: the specification cannot safely proceed. MAJOR: a substantial planning problem. MINOR: usable but should be corrected. OBSERVATION: worth review, not necessarily a defect.",
          "enum": ["CRITICAL", "MAJOR", "MINOR", "OBSERVATION"]
        },
        "category": {
          "enum": [
            "REQUIREMENT", "SCOPE", "WORKFLOW", "DATA", "SECURITY", "AUTHORIZATION", "ARCHITECTURE", "INTEGRATION",
            "TRACEABILITY", "ROADMAP", "RISK", "TERMINOLOGY", "CHANGE_IMPACT", "ACCEPTANCE_CRITERIA", "ASSUMPTION"
          ]
        },
        "status": {
          "description": "OPEN, ACKNOWLEDGED and IN_RESOLUTION are unresolved. RESOLVED is verified by re-review in a later cycle. ACCEPTED_RISK is a named human's decision with evidence, never for a CRITICAL finding, and stays visible. REJECTED means judged not to be a defect.",
          "enum": ["OPEN", "ACKNOWLEDGED", "IN_RESOLUTION", "RESOLVED", "ACCEPTED_RISK", "REJECTED"]
        },
        "raised_in_cycle": { "type": ["integer", "null"], "minimum": 1 },
        "closed_in_cycle": { "type": ["integer", "null"], "minimum": 1 },
        "affected_artifacts": { "$ref": "common.schema.json#/$defs/anyIdList" },
        "return_to_stage": { "type": ["string", "null"] },
        "evidence": { "type": "string" },
        "conflict": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "required_action": { "type": "string" },
        "resolution": {
          "description": "How a closed finding was closed; null while it is unresolved. For ACCEPTED_RISK, text is the reason the risk is accepted; for REJECTED, why it is not a defect.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "resolved_by", "resolution_date", "changed_artifacts", "verification", "approved_by", "approval_evidence"],
              "properties": {
                "text": { "type": "string" },
                "resolved_by": { "type": ["string", "null"] },
                "resolution_date": { "oneOf": [{ "type": "null" }, { "$ref": "common.schema.json#/$defs/isoDate" }] },
                "changed_artifacts": { "$ref": "common.schema.json#/$defs/anyIdList" },
                "verification": { "type": "string" },
                "approved_by": { "type": ["string", "null"] },
                "approval_evidence": { "$ref": "common.schema.json#/$defs/anyIdList" }
              }
            }
          ]
        },
        "source_path": { "$ref": "common.schema.json#/$defs/sourcePath" }
      }
    }
  }
}
